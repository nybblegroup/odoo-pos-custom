<odoo>
    <data>

       <record id="res_config_settings_view_form_einvoice" model="ir.ui.view">
            <field name="name">res.config.settings.einvoice.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                    <setting string="Print PDF Invoice" id="pos_print_pdf_invoice" help="Display the PDF invoice in the POS interface.">
                        <field name="print_pdf_invoice"/>
                    </setting>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
