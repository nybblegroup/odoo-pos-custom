<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Add columns to Partner List header -->
    <t t-name="point_of_sale.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <xpath expr="//thead/tr/th[@class='partner-line-email py-2']" position="after">
            <th class="py-2 text-center">AFIP Responsibility</th>
            <th class="py-2 text-center">ID Type</th>
            <th class="py-2 text-center">VAT/ID Number</th>
        </xpath>
    </t>

    <!-- Add columns to Partner Line (Desktop view) -->
    <t t-name="point_of_sale.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <!-- Add after the contact column (partner-line-email) -->
        <xpath expr="//td[@class='partner-line-email ']" position="after">
            <td class="text-center afip-responsibility">
                <t t-if="props.partner.l10n_ar_afip_responsibility_type_id">
                    <t t-esc="props.partner.l10n_ar_afip_responsibility_type_id.name" />
                </t>
                <t t-else="">-</t>
            </td>
            <td class="text-center identification-type">
                <t t-if="props.partner.l10n_latam_identification_type_id">
                    <t t-esc="props.partner.l10n_latam_identification_type_id.name" />
                </t>
                <t t-else="">-</t>
            </td>
            <td class="text-center vat-number">
                <t t-if="props.partner.vat">
                    <t t-esc="props.partner.vat" />
                </t>
                <t t-else="">-</t>
            </td>
        </xpath>

        <!-- Add to Mobile view -->
        <xpath expr="//div[@class='partner-line-email p-1']" position="after">
            <div class="partner-ar-info p-1 text-muted small">
                <div t-if="props.partner.l10n_ar_afip_responsibility_type_id">
                    <i class="fa fa-institution me-1"/>
                    <t t-esc="props.partner.l10n_ar_afip_responsibility_type_id.name" />
                </div>
                <div t-if="props.partner.l10n_latam_identification_type_id or props.partner.vat">
                    <i class="fa fa-id-card me-1"/>
                    <t t-if="props.partner.l10n_latam_identification_type_id">
                        <t t-esc="props.partner.l10n_latam_identification_type_id.name" />:
                    </t>
                    <t t-if="props.partner.vat">
                        <t t-esc="props.partner.vat" />
                    </t>
                </div>
            </div>
        </xpath>
    </t>

</templates>
